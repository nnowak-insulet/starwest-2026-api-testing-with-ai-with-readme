{
  "name": "starwest-2026-api-testing-with-ai",
  "version": "1.0.0",
  "description": "E-commerce REST API with JWT authentication and checkout",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "mocha 'test/pathCoverage/**/*.test.js' --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=path-coverage-report,html=true,json=true",
    "test:path-coverage": "npm test"
  },
  "keywords": [
    "express",
    "jwt",
    "ecommerce",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "mocha": "^12.0.2",
    "mochawesome": "^8.1.1",
    "supertest": "^7.3.0"
  }
}
